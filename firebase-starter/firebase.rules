©Gianna G. Dimperio 2026

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function isMember(wid) {
      return signedIn() && exists(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }
    function isOwner(wid) {
      return signedIn() && get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerId == request.auth.uid;
    }
    function memberDoc(wid) {
      return get(/databases/$(database)/documents/workspaces/$(wid)/members/$(request.auth.uid));
    }
    function ownerOf(wid) { return get(/databases/$(database)/documents/workspaces/$(wid)).data.ownerId; }
    // Admins run the workspace: the owner (who created it) plus any member an admin has made an admin
    // (for example a second founder or CEO). Admins can rename the workspace, change its logo, invite and
    // remove people, choose who can edit lists, and make other members admins.
    function isAdmin(wid) {
      return signedIn() && (isOwner(wid)
        || (isMember(wid) && memberDoc(wid).data.get('admin', false) == true));
    }
    // Signed in with a verified email that has a pending invitation to this workspace
    function isInvited(wid) {
      return signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/workspaces/$(wid)/invites/$(request.auth.token.email.lower()));
    }
    // Can change lists: admins, or a member an admin switched "Can edit lists" on for (Settings > Members)
    function canEditWs(wid) {
      return signedIn() && (isAdmin(wid)
        || (isMember(wid) && memberDoc(wid).data.get('canEdit', false) == true));
    }
    function jobWs(jobId) { return get(/databases/$(database)/documents/jobs/$(jobId)).data.workspaceId; }
    // The write changes only these fields
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 50; }
    // Company logo: optional, a small image data URL (settings.html shrinks it to 256px)
    function validLogo(d) { return !('logo' in d) || d.logo == null || (d.logo is string && d.logo.size() < 400000); }

    // ---------- workspaces ----------
    match /workspaces/{wid} {
      // Anyone can create their own workspace. Reading is one doc at a time (no listing everybody's workspaces).
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && validName(request.resource.data.name);
      allow get: if signedIn() && (resource.data.ownerId == request.auth.uid || isMember(wid) || isInvited(wid));
      allow update: if isAdmin(wid)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && validName(request.resource.data.name)
                    && validLogo(request.resource.data);

      // The people in the workspace
      match /members/{memberId} {
        allow read: if isMember(wid);
        // You can only add yourself: as owner of a workspace you created, or as a member if you were invited
        // Nobody can give themselves editing or admin access when they join
        allow create: if signedIn() && memberId == request.auth.uid
                      && request.resource.data.get('canEdit', false) == false
                      && request.resource.data.get('admin', false) == false
                      && ((isOwner(wid) && request.resource.data.role == 'owner')
                          || (isInvited(wid) && request.resource.data.role == 'member'));
        // Edit your own profile, but never your own role, editing access or admin access.
        // Admins can switch "Can edit lists" and "Admin" on or off for other members (and change nothing else on
        // their record). The owner who created the workspace is always an admin: nobody can change or remove them.
        allow update: if (signedIn() && memberId == request.auth.uid
                          && request.resource.data.role == resource.data.role
                          && request.resource.data.get('canEdit', false) == resource.data.get('canEdit', false)
                          && request.resource.data.get('admin', false) == resource.data.get('admin', false))
                      || (isAdmin(wid) && memberId != request.auth.uid && memberId != ownerOf(wid)
                          && onlyChanges(['canEdit', 'admin'])
                          && request.resource.data.get('canEdit', false) is bool
                          && request.resource.data.get('admin', false) is bool);
        allow delete: if (isAdmin(wid) && memberId != ownerOf(wid)) || (signedIn() && memberId == request.auth.uid);
      }

      // One doc per invited email (the doc id is the lowercase email)
      match /invites/{inviteId} {
        allow get: if isMember(wid) || (signedIn() && request.auth.token.email.lower() == inviteId);
        allow list: if isMember(wid);
        allow create: if isMember(wid) && inviteId == request.resource.data.email;
        allow delete: if isMember(wid) || (signedIn() && request.auth.token.email.lower() == inviteId);
      }

      // Username claims so two people can't use the same username in one workspace
      match /usernames/{uname} {
        allow read: if isMember(wid) || isOwner(wid) || isInvited(wid);
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
                      && (isMember(wid) || isOwner(wid) || isInvited(wid));
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Shared trades, levels and folders: everyone in the workspace can read them, only editors can change them
      match /settings/{docId} {
        allow read: if isMember(wid);
        allow write: if canEditWs(wid);
      }
    }

    // ---------- projects ----------
    // A project (made on newProject.html) holds its details and timeline. Its punch lists are jobs with projectId set.
    // Everyone in the workspace can see projects; editors (admins + members allowed to edit) can create and change them.
    // Only admins (the owner + anyone made an admin) can delete one.
    match /projects/{projectId} {
      allow get: if isMember(resource.data.workspaceId);
      allow list: if isMember(resource.data.workspaceId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && canEditWs(request.resource.data.workspaceId)
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80;
      allow update: if canEditWs(resource.data.workspaceId)
                    && request.resource.data.workspaceId == resource.data.workspaceId
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAdmin(resource.data.workspaceId);
    }

    // ---------- lists ----------
    // Editors (admins + members allowed to edit) can change anything on a list.
    // Everyone else, including people who open a shared link, can only check items off.
    match /jobs/{jobId} {
      // Anyone with the link can open one list (this is what shared links use)
      allow get: if true;
      // Only people in the list's workspace can browse lists
      allow list: if isMember(resource.data.workspaceId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && canEditWs(request.resource.data.workspaceId);
      allow delete: if canEditWs(resource.data.workspaceId);
      // Nobody can change who owns the list or which workspace it is in.
      // Non-editors can only update the open/total counts, which refresh when they check items off.
      allow update: if request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.workspaceId == resource.data.workspaceId
                    && (canEditWs(resource.data.workspaceId)
                        || onlyChanges(['openCount', 'totalCount', 'updatedAt']));

      // Item status (done, note, trade). Checking off only changes done / doneAt / signedBy / signature / updatedAt.
      // CHANGED: marking an item done now requires a signature (the signer's typed name + a drawn signature image).
      match /items/{itemId} {
        allow read: if true;
        allow delete: if canEditWs(jobWs(jobId));
        allow create: if (!newlyDone() || hasSig(request.resource.data))
                      && (canEditWs(jobWs(jobId))
                          || (request.resource.data.keys().hasOnly(['done', 'doneAt', 'signedBy', 'signature', 'note', 'trade', 'updatedAt'])
                              && request.resource.data.get('note', '') == ''
                              && request.resource.data.get('trade', '') == ''));
        allow update: if (!newlyDone() || hasSig(request.resource.data))
                      && (canEditWs(jobWs(jobId))
                          || onlyChanges(['done', 'doneAt', 'signedBy', 'signature', 'updatedAt']));
      }
      // ADDED: true when this write switches the item from not done to done
      function newlyDone() {
        return request.resource.data.get('done', false) == true
          && (resource == null || resource.data.get('done', false) != true);
      }
      // ADDED: a name (1-60 characters) and a PNG signature image under about 100 KB
      function hasSig(d) {
        return d.get('signedBy', '') is string && d.get('signedBy', '').size() > 0 && d.get('signedBy', '').size() <= 60
          && d.get('signature', '') is string && d.get('signature', '').size() < 100000
          && d.get('signature', '').matches('data:image/png;base64,[A-Za-z0-9+/=]+');
      }
      // The items themselves, rooms, and hidden rooms: editors only
      match /{coll}/{docId} {
        allow read: if coll in ['custom', 'rooms', 'hidden'];
        allow write: if coll in ['custom', 'rooms', 'hidden'] && canEditWs(jobWs(jobId));
      }
    }

    // ---------- each person's own profile ----------
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
