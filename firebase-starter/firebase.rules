rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      allow read, write: if true;
      match /{coll}/{docId} {
        allow read, write: if coll in ['items', 'custom', 'rooms', 'hidden'];
      }
    }

    // Shared, editable trade list
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Each signed-in user can only read/write their own profile data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}