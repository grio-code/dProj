  rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /jobs/{jobId} {
      allow read, write: if true;
      match /{coll}/{docId} {
        allow read, write: if coll in ['items', 'custom', 'rooms', 'hidden'];
      }
    }
    // Shared, editable trade list
    match /settings/{docId} {
      allow read, write: if true;
    }
  }
}