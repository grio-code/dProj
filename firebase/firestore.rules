rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /jobs/{jobId} {
      allow get, update: if true;
      allow list, create, delete: if request.auth != null;
      match /{sub}/{docId} {
        allow read, write: if true;
      }
    }
  }
}